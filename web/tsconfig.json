{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": { "@old/*": ["../dashboard/src/*"] }
  },
  "include": ["src", "../dashboard/src/api", "../dashboard/src/hooks", "../dashboard/src/lib"],
  "exclude": ["../dashboard/src/**/*.test.ts", "../dashboard/src/**/*.test.tsx"]
}
